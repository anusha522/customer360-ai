# Copy this file to secrets.toml and fill in your Snowflake credentials.
# DO NOT commit the actual secrets.toml to version control.

[connections.snowflake]
account = "YOUR_SNOWFLAKE_ACCOUNT"
user = "YOUR_USERNAME"
password = "YOUR_PASSWORD"
authenticator = "snowflake"
database = "CUSTOMER_360_DB"
schema = "C360"
warehouse = "COMPUTE_WH"
